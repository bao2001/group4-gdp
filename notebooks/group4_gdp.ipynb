import pandas as pd
import numpy as np
import yfinance as yf
from pandas_datareader import data as pdr

start = "1990-01-01"
end = "2025-12-31"

# FRED
gdp = pdr.DataReader("GDPC1", "fred", start, end)
unrate = pdr.DataReader("UNRATE", "fred", start, end)
pcepi = pdr.DataReader("PCEPI", "fred", start, end)
fedfunds = pdr.DataReader("FEDFUNDS", "fred", start, end)
spread = pdr.DataReader("T10Y2Y", "fred", start, end)

# Yahoo Finance
sp500 = yf.download("^GSPC", start=start, end=end, auto_adjust=True, progress=False)
vix = yf.download("^VIX", start=start, end=end, auto_adjust=True, progress=False)

sp500 = sp500[["Close"]].rename(columns={"Close": "SP500_Close"})
vix = vix[["Close"]].rename(columns={"Close": "VIX_Close"})

# Monthly/daily to quarterly
unrate_q = unrate.resample("Q").mean()
pcepi_q = pcepi.resample("Q").mean()
fedfunds_q = fedfunds.resample("Q").mean()
spread_q = spread.resample("Q").mean()
sp500_q = sp500.resample("Q").last()
vix_q = vix.resample("Q").mean()

# GDP is already quarterly, but align index style
gdp_q = gdp.copy()
gdp_q.index = gdp_q.index.to_period("Q").to_timestamp("Q")

# Standardize the other quarterly indices
for df in [unrate_q, pcepi_q, fedfunds_q, spread_q, sp500_q, vix_q]:
    df.index = df.index.to_period("Q").to_timestamp("Q")

master = pd.concat(
    [gdp_q, unrate_q, pcepi_q, fedfunds_q, spread_q, sp500_q, vix_q],
    axis=1
)

master.columns = [
    "GDPC1",
    "UNRATE",
    "PCEPI",
    "FEDFUNDS",
    "T10Y2Y",
    "SP500_Close",
    "VIX_Close"
]

master = master.dropna().copy()
master.head()

master.to_csv("data/processed/master_quarterly.csv")
print(master.shape)
print(master.tail())
